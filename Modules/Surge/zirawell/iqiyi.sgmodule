[Script]
爱奇艺-Cookie = type=http-request, pattern=^https?:\/\/passport\.iqiyi\.com\/apis\/user\/, script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/CheckIn/iqiyi.js

爱奇艺-签到 = type=cron, cronexp=0 9 * * *, script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/CheckIn/iqiyi.js, wake-system=1

# 爱奇艺-Cookie
iqiyi = type=http-request, pattern=^https?:\/\/passport\.iqiyi\.com\/apis\/user\/, script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/CheckIn/iqiyi.js, timeout=60

[MITM]
hostname = %APPEND% passport.iqiyi.com

