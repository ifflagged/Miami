#!name=zhuanzhuan-rewrite
#!desc=zhuanzhuan-rewrite
#!icon=icon not found
#!category={encoded_author}

[Map Local]
# > 转转 - ZHUANZHUAN
^https?:\/\/app\.zhuanzhuan\.com\/zzx\/transfer\/getConfigInfo data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 转转右下角悬浮广告
^https?:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/userred\?scene=homePage data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# “我的”页面去除冗余的模块
zhuanzhuan = type=http-response, pattern=^https?:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/getmyprofilev, script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/zhuanzhuan-rewrite/zirawell_zhuanzhuan.js, requires-body=true, max-size=-1, timeout=60

replaceBody = type=http-response, pattern=^https?:\/\/app\.zhuanzhuan\.com\/zz\/v\d\/zzinfoshow\/getchoicegoodsinfos, script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/zhuanzhuan-rewrite/Script-Hub-Org_replace-body.js, requires-body=true, max-size=-1, timeout=30, argument=infoData-%3Erandom_body

[MITM]
hostname = %APPEND% app.zhuanzhuan.com

