#!name=ems
#!desc=ems
#!icon=icon not found
#!category=zirawell

[URL Rewrite]
^https?:\/\/\w+\.ems\.com\.cn\/mailAd$ - reject
^https?:\/\/\w+\.ems\.com\.cn\/[A-Za-z-]+\/advert - reject

[Map Local]
^https?:\/\/\w+\.ems\.com\.cn\/[A-Za-z-]+\/adPlatform data-type=json data="{}" status-code=200

[Script]
ems = type=http-response, pattern=^https?:\/\/\w+\.ems\.com\.cn\/[A-Za-z-]+\/redis\/pageInfoByChannel, script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/wechatApplet.js, requires-body=true, max-size=0

[MITM]
hostname = %APPEND% ec.ems.com.cn, ump.ems.com.cn

