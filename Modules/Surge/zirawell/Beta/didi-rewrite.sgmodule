#!name=didi-rewrite
#!desc=didi-rewrite
#!icon=icon not found
#!category={encoded_author}

[URL Rewrite]
^https?:\/\/ut\.xiaojukeji\.com\/ut\/kappa\/api\/owner\/index\/dialog - reject

[Map Local]
# > 滴滴出行 - DIDI
^https?:\/\/hd\.xiaojukeji\.com\/d data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/ct\.xiaojukeji\.com\/agent\/v\d\/feeds data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/omgup\d?\.xiaojukeji\.com\/api data-type=text data=" " status-code=200

^https?:\/\/res\.xiaojukeji\.com\/resapi\/activity\/(?>m|xp)get data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/as\.xiaojukeji\.com\/ep\/as\/toggles data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/as\.xiaojukeji\.com\/ep\/as\/conf\?ns=daijia-front&name= data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/freight\.xiaojukeji\.com\/gateway(?!\?api=freight\.p\.personal\.center) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/api\.udache\.com\/gulfstream\/confucius\/api\/privacy\/app\/popList data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/pt-starimg\.didistatic\.com\/static\/starimg\/node\/.*.(?>jpg|png|gif) data-type=text data=" " status-code=200

^https?:\/\/conf\.diditaxi\.com\.cn\/dynamic\/conf data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/fast data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
replaceBody = type=http-response, pattern=^https?:\/\/ut\.xiaojukeji\.com\/ut\/kappa\/api\/owner\/index, script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/didi-rewrite/Script-Hub-Org_replace-body.js, requires-body=true, max-size=-1, timeout=30, argument=banner_items-%3Erandom_body

didi = type=http-response, pattern=^https?:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/core, script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/didi-rewrite/zirawell_didi.js, requires-body=true, max-size=-1, timeout=60

didi = type=http-response, pattern=^https?:\/\/conf\.diditaxi\.com\.cn\/ota\/na\/yuantu\/infoList, script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/didi-rewrite/zirawell_didi.js, requires-body=true, max-size=-1, timeout=60

didi = type=http-response, pattern=^https?:\/\/common\.diditaxi\.com\.cn\/common\/v\d\/usercenter\/me, script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/didi-rewrite/zirawell_didi.js, requires-body=true, max-size=-1, timeout=60

didi = type=http-response, pattern=^https?:\/\/api\.udache\.com\/gulfstream\/pre-sale\/v\d\/other\/pGetSceneList, script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/didi-rewrite/zirawell_didi.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% hd.xiaojukeji.com, ct.xiaojukeji.com, omgup*.xiaojukeji.com, res.xiaojukeji.com, as.xiaojukeji.com, freight.xiaojukeji.com, ut.xiaojukeji.com, api.udache.com, pt-starimg.didistatic.com, conf.diditaxi.com.cn, common.diditaxi.com.cn

