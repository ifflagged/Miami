#!name=eleme-rewrite
#!desc=eleme-rewrite
#!icon=icon not found
#!category=Jacob

[URL Rewrite]
^https?:\/\/nr-op\.elemecdn\.com\/eleme\/transformer\/templates\/\w_eleme_home_yolo_popup - reject

[Map Local]
# > 淘宝闪购 - TBTO
^https?:\/\/amdc\.m\.ele\.me\/amdc\/mobileDispatch data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/g\.alicdn\.com\/TBTakeout\/et-store\/(\d+.)*\/weex\/store-brand-popup data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/(?>nr-op|cube)\.elemecdn\.com\/image\/.*\.(png|jpeg|jpg|gif)\?x-oss-process=image\/resize,m_fill,w_180,h_180\/($|format,webp\/$) data-type=tiny-gif status-code=200

[MITM]
hostname = %APPEND% amdc.m.ele.me, g.alicdn.com, nr-op.elemecdn.com, cube.elemecdn.com

