#!name=ctrip
#!desc=ctrip
#!icon=icon not found
#!category=zirawell

[Script]
携程旅行-Cookie = type=http-response, pattern=^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/[a-zA-Z]+Login(?:$|\?), script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/CheckIn/ctrip.js

携程旅行-签到 = type=cron, cronexp=5 0 * * *, script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/CheckIn/ctrip.js, wake-system=1

# 携程旅行-Cookie
ctrip = type=http-response, pattern=^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/[a-zA-Z]+Login(?:$|\?), script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/CheckIn/ctrip.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% m.ctrip.com

