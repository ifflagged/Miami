#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-11-13

[Rule]
DOMAIN,imc.abchina.com.cn,REJECT,extended-matching
DOMAIN,apm.abchina.com.cn,REJECT,extended-matching
DOMAIN,msmp.abchina.com.cn,REJECT,extended-matching
DOMAIN,mb.cdn-static.abchina.com.cn,REJECT,extended-matching
DOMAIN,firefly.abchina.com.cn,REJECT,extended-matching

[Map Local]
# ⚠️域名[mobilepaas.abchina.com.cn]已无法MITM，可能会导致App端部分功能无法使用，请自行选择是否需要
^https?:\/\/mall\.abchina\.com\.cn\/pips\/EbizccmClientServer\/PIPSPopupAdvertisement data-type=json data="{}"

[Script]
abc = type=http-response, pattern=^https?:\/\/(?>midc|mb-mbc)\.cdn-static\.abchina\.com\.cn\/distributecenterimg\/file\/download, script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/abc/zirawell_adImage.js, requires-body=true, max-size=0

[MITM]
hostname = %APPEND% mall.abchina.com.cn, midc.cdn-static.abchina.com.cn, mb-mbc.cdn-static.abchina.com.cn

