#!name=flyert-CheckIn
#!desc=flyert-CheckIn
#!icon=icon not found
#!category=zirawell

[Script]
飞客-Cookie = type=http-request, pattern=^https?:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=getdata&.*, script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/CheckIn/flyert.js

飞客-签到 = type=cron, cronexp=10 0 * * *, script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/CheckIn/flyert.js, wake-system=1

# 飞客-Cookie
flyert = type=http-request, pattern=^https?:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=getdata&.*, script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/CheckIn/flyert.js, timeout=60

[MITM]
hostname = %APPEND% www.flyert.com.cn

