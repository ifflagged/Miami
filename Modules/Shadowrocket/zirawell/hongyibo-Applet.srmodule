#!name=hongyibo-Applet
#!desc=hongyibo-Applet
#!icon=icon not found
#!category={encoded_author}

[Rule]
DOMAIN,api.hongyibo.com.cn,REJECT,extended-matching

[Map Local]
^https?:\/\/res\.hongyibo\.com\.cn\/os\/gs\/resapi\/activity data-type=json data="{}"

[MITM]
hostname = %APPEND% res.hongyibo.com.cn

