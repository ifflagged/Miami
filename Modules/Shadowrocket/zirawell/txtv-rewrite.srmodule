#!name=txtv-rewrite
#!desc=txtv-rewrite
#!icon=icon not found
#!category=Jacob

[URL Rewrite]
# > 腾讯视频 - TXTV
^https?:\/\/vv\.video\.qq\.com\/(?>diff|get)vmind - reject-dict
^https?:\/\/apd-vlive\.apdcdn\.tc\.qq\.com\/vmind\.qqvideo\.tc\.qq\.com\/\w+ - reject
^https?:\/\/apd-\w+\.v\.smtcdns\.com\/(defaultts|omts|vmind\.qqvideo)\.tc\.qq\.com\/ - reject
^https?:\/\/ossgw\.alicdn\.com\/creatives-assets\/prod\/feupload\/user - reject

[Script]
replaceBody = type=http-request, pattern=^https?:\/\/vv\.video\.qq\.com\/getvinfo, script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/txtv-rewrite/Script-Hub-Org_replace-body.js, requires-body=true, max-size=-1, timeout=30, argument=%26sppreviewtype%3D%5Cd(.*)%26spsrt%3D%5Cd-%3E%26sppreviewtype%3D0%241%26spsrt%3D0

[MITM]
hostname = %APPEND% vv.video.qq.com, apd-vlive.apdcdn.tc.qq.com, apd-*.v.smtcdns.com, ossgw.alicdn.com

