#!name=JD_Price
#!desc=JD_Price
#!icon=icon not found
#!category=zirawell

[Script]
JD_Price = type=http-response, pattern=^https?:\/\/api\.m\.jd\.com/client\.action\?functionId=(wareBusiness|serverConfig|basicConfig), script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/Plugins/JD_Price.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.m.jd.com

