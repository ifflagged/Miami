#!date=2026-11-21

[Rule]
DOMAIN,adm.10jqka.com.cn,REJECT,extended-matching
DOMAIN,stat.10jqka.com.cn,REJECT,extended-matching

[Body Rewrite]
http-response-jq ^https?:\/\/recommend\.10jqka\.com\.cn\/app\/discover\/api\/v\d\/recommend '.data |= map(select(.info.subject != "ad")) | .total = (.data | length)'

[MITM]
hostname = %APPEND% recommend.10jqka.com.cn

