[Rule]
# 请求本地
DOMAIN-SUFFIX,local,DIRECT

[Script]
# BoxJS
cron "0 0/6 * * *" script-path=https://raw.githubusercontent.com/dompling/Script/master/gist/backup.js, timeout=120, tag=Gist备份, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/BoxJS.png

cron "5 10 * * *" script-path=https://raw.githubusercontent.com/dompling/Script/master/gist/restore.js, timeout=120, tag=Gist恢复, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/BoxJS.png

[MITM]
hostname = -www.google.com

