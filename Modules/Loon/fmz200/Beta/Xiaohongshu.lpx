#!name=小红书
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Loon/plugin/split/partX/Xiaohongshu.lpx
#!tg-channel=https://t.me/inaisi
#!date=2026-10-01 22:20:00

[Argument]
xhs_enable=switch,true,false,tag=小红书-脚本开关

[Rule]
DOMAIN,ads-img-qc.xhscdn.com,REJECT
DOMAIN,ads-video-al.xhscdn.com,REJECT
DOMAIN,ads-video-qc.xhscdn.com,REJECT
DOMAIN,t-ads.xiaohongshu.com,REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,xiaohongshu.com)),REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.(xiaohongshu|rnote)\.com\/api\/marketing\/box\/trigger\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/note\/guide\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/note\/detailfeed\/preload\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/guide\/user_banner/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.(xiaohongshu|rnote)\.com\/api\/sns\/(v\d+\/ads\/resource|v\d+\/hey\/\w+\/hey_gallery)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/ci\.(xiaohongshu|rnote)\.com\/system_config\/watermark/i then reject_img(200)

[Script]
response if ${url} ~= /^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/(banner|hot)_list/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/fmz200/Xiaohongshu/fmz200_xiaohongshu.js") with tag="小红书搜索页", timeout=60, enable=${xhs_enable}, requires_body=true

response if ${url} ~= /^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/(hint|trending)\?/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/fmz200/Xiaohongshu/fmz200_xiaohongshu.js") with tag="小红书搜索页", timeout=60, enable=${xhs_enable}, requires_body=true

response if ${url} ~= /^https?:\/\/(so|edith)\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/notes\?/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/fmz200/Xiaohongshu/fmz200_xiaohongshu.js") with tag="小红书搜索页", timeout=60, enable=${xhs_enable}, requires_body=true

response if ${url} ~= /^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/system_service\/config\?/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/fmz200/Xiaohongshu/fmz200_xiaohongshu.js") with tag="小红书开屏广告", timeout=60, enable=${xhs_enable}, requires_body=true

response if ${url} ~= /^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/system_service\/splash_config/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/fmz200/Xiaohongshu/fmz200_xiaohongshu.js") with tag="小红书开屏广告", timeout=60, enable=${xhs_enable}, requires_body=true

response if ${url} ~= /^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/note\/widgets/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/fmz200/Xiaohongshu/fmz200_xiaohongshu.js") with tag="小红书详情页", timeout=60, enable=${xhs_enable}, requires_body=true

response if ${url} ~= /^https?:\/\/(edith|rec|www)\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/note\/(imagefeed|live_photo\/save)/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/fmz200/Xiaohongshu/fmz200_xiaohongshu.js") with tag="小红书图片视频水印", timeout=60, enable=${xhs_enable}, requires_body=true

response if ${url} ~= /^https?:\/\/(edith|rec|www)\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/(followfeed|homefeed)\?/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/fmz200/Xiaohongshu/fmz200_xiaohongshu.js") with tag="小红书图片视频水印", timeout=60, enable=${xhs_enable}, requires_body=true

response if ${url} ~= /^https?:\/\/(edith|rec|www)\.(xiaohongshu|rnote)\.com\/api\/sns\/(v2\/note\/feed|v3\/note\/videofeed)\?/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/fmz200/Xiaohongshu/fmz200_xiaohongshu.js") with tag="小红书图片视频水印", timeout=60, enable=${xhs_enable}, requires_body=true

response if ${url} ~= /^https?:\/\/(edith|rec|www)\.(xiaohongshu|rnote)\.com\/api\/sns\/(v4\/note\/videofeed|v10\/note\/video\/save)\?/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/fmz200/Xiaohongshu/fmz200_xiaohongshu.js") with tag="小红书图片视频水印", timeout=60, enable=${xhs_enable}, requires_body=true

response if ${url} ~= /^https:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/(v5\/note\/comment\/list|v3\/note\/comment\/sub_comments)\?/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/fmz200/Xiaohongshu/fmz200_xiaohongshu.js") with tag="小红书评论区去水印存储", timeout=60, enable=${xhs_enable}, requires_body=true

response if ${url} ~= /^https:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v1\/interaction\/comment\/video\/download\?/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/fmz200/Xiaohongshu/fmz200_xiaohongshu.js") with tag="小红书评论区去水印下载", timeout=60, enable=${xhs_enable}, requires_body=true

[MITM]
hostname = edith.xiaohongshu.com, www.xiaohongshu.com, ci.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com, edith.rnote.com, www.rnote.com, ci.rnote.com, so.rnote.com, rec.rnote.com

