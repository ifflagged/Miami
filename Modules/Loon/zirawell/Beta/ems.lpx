#!name=ems
#!desc=ems
#!icon=icon not found
#!tag={encoded_author}

[Rewrite]
^https?:\/\/\w+\.ems\.com\.cn\/mailAd$ - reject
^https?:\/\/\w+\.ems\.com\.cn\/[A-Za-z-]+\/advert - reject
^https?:\/\/\w+\.ems\.com\.cn\/[A-Za-z-]+\/adPlatform mock-response-body data-type=json data="{}" status-code=200

[Script]
http-response ^https?:\/\/\w+\.ems\.com\.cn\/[A-Za-z-]+\/redis\/pageInfoByChannel script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/ems/zirawell_wechatApplet.js, requires-body=true, tag=ems

[MITM]
hostname = ec.ems.com.cn, ump.ems.com.cn

