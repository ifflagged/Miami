#!name=iqiyi-rewrite
#!desc=iqiyi-rewrite
#!icon=icon not found
#!tag=Jacob

[Rewrite]
# 播放页开通会员提示
^https?:\/\/act\.vip\.iqiyi\.com\/interact\/api(\/v\d)?\/show - reject-dict
# 播放页多余动效
^https?:\/\/iface2\.iqiyi\.com\/ivos\/interact\/video\/data\? - reject-dict
# 播放页升级白金会员按钮
^https?:\/\/iface2\.iqiyi\.com\/video\/3\.0\/v_interface_proxy\? - reject-dict
# 青少年弹窗
^https?:\/\/iface2\.iqiyi\.com\/views_pop\/3\.0\/pop_control\? - reject-dict

[Script]
# 首页信息流广告
http-response ^https?:\/\/[\d\.]+\/3f1\/cards\.iqiyi\.com\/(views_home\/3\.0\/qy_home|waterfall\/3\.0\/feed)\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

http-response ^https?:\/\/access\.if\.iqiyi\.com\/3f1\/cards\.iqiyi\.com\/(views_category\/3\.0\/category_home|views_home\/3\.0\/qy_home|waterfall\/3\.0\/feed)\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

http-response ^https?:\/\/cards\.iqiyi\.com\/views_category\/3\.0\/(category_home|categorylib_content|film_hybrid)\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

http-response ^https?:\/\/cards\.iqiyi\.com\/(views_home\/3\.0\/qy_home|waterfall\/3\.0\/feed)\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

# 播放详情页
http-response ^https?:\/\/cards\.iqiyi\.com\/views_plt\/3\.0\/player_tabs_v2\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

# 搜索页列表
http-response ^https?:\/\/cards\.iqiyi\.com\/views_search\/3\.0\/(hot_query_)?search\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

# 评论区
http-response ^https?:\/\/comment-card\.iqiyi\.com\/views_comment\/3\.0\/long_video_comments\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

# 我的页面菜单
http-response ^https?:\/\/iface2\.iqiyi\.com\/aggregate\/3\.0\/getMyMenus\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

# 首页左上角天气
http-response ^https?:\/\/iface2\.iqiyi\.com\/control\/3\.0\/init_proxy\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

# 通用控制,各tab页二楼
http-response ^https?:\/\/iface2\.iqiyi\.com\/fusion\/3\.0\/common_switch\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

# 底部tab,顶部tab
http-response ^https?:\/\/iface2\.iqiyi\.com\/views\/3\.0\/(bottom_theme|home_top_menu)\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

# 搜索框填充词
http-response ^https?:\/\/search\.video\.iqiyi\.com\/q\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

# 开屏广告,播放广告
http-response ^https?:\/\/(kjp|t7z)\.cupid\.iqiyi\.com\/mixer\? script-path=https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/zirawell/iqiyi-rewrite/zirawell_cntv.js, requires-body=true, timeout=60, tag=cntv

[MITM]
hostname = -i.vip.iqiyi.com, *.iqiyi.com

