[Rule]
DOMAIN,adm.10jqka.com.cn,REJECT
DOMAIN,stat.10jqka.com.cn,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/recommend\.10jqka\.com\.cn\/app\/discover\/api\/v\d\/recommend/i then response.json.jq(".data |= map(select(.info.subject != \"ad\")) | .total = (.data | length)")

[MITM]
hostname = recommend.10jqka.com.cn

