#!name=eleme-rewrite
#!desc=eleme-rewrite
#!icon=icon not found
#!tag=Jacob

[Rewrite]
# > 淘宝闪购 - TBTO
^https?:\/\/amdc\.m\.ele\.me\/amdc\/mobileDispatch - reject-dict
^https?:\/\/g\.alicdn\.com\/TBTakeout\/et-store\/(\d+.)*\/weex\/store-brand-popup - reject-dict
^https?:\/\/nr-op\.elemecdn\.com\/eleme\/transformer\/templates\/\w_eleme_home_yolo_popup - reject
^https?:\/\/(?>nr-op|cube)\.elemecdn\.com\/image\/.*\.(png|jpeg|jpg|gif)\?x-oss-process=image\/resize,m_fill,w_180,h_180\/($|format,webp\/$) - reject-img

[MITM]
hostname = amdc.m.ele.me, g.alicdn.com, nr-op.elemecdn.com, cube.elemecdn.com

