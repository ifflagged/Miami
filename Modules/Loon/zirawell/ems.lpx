#!name=ems
#!desc=ems
#!icon=icon not found
#!tag=zirawell

[Rewrite]
^https?:\/\/\w+\.ems\.com\.cn\/mailAd$ - reject
^https?:\/\/\w+\.ems\.com\.cn\/[A-Za-z-]+\/advert - reject
^https?:\/\/\w+\.ems\.com\.cn\/[A-Za-z-]+\/adPlatform mock-response-body data-type=json data="{}" status-code=200

[Script]
http-response ^https?:\/\/\w+\.ems\.com\.cn\/[A-Za-z-]+\/redis\/pageInfoByChannel script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/wechatApplet.js, requires-body=true, tag=ems

[MITM]
hostname = ec.ems.com.cn, ump.ems.com.cn

