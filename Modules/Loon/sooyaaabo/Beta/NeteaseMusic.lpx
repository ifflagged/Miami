#!name=网易云音乐
#!desc=网易云音乐全面净化，可自定义界面样式。
#!author=Yu9191[https://github.com/Yu9191]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://apps.apple.com/app/id590338362
#!tag=去广告, 解锁会员
#!loon_version=3.5.3(1014)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-11-25 20:00

[Argument]
FX=switch,false,true,tag = 底部-发现, desc = true为隐藏, false为显示
MY=switch,true,false,tag = 底部-漫游, desc = true为隐藏, false为显示
DT=switch,true,false,tag = 底部-笔记, desc = true为隐藏, false为显示
GZ=switch,true,false,tag = 底部-关注, desc = true为隐藏, false为显示
SOU=switch,true,false,tag = 底部-搜索, desc = true为隐藏, false为显示
SY_NAME=input,"",tag = 底部-首页名称, desc = 自定义名称，留空则保持原名，填写则替换显示
WD_NAME=input,"",tag = 底部-我的名称, desc = 自定义名称，留空则保持原名，填写则替换显示
MY_NAME=input,"",tag = 底部-漫游名称, desc = 自定义名称，留空则保持原名，填写则替换显示
DT_NAME=input,"",tag = 底部-笔记名称, desc = 自定义名称，留空则保持原名，填写则替换显示
FX_NAME=input,"",tag = 底部-发现名称, desc = 自定义名称，留空则保持原名，填写则替换显示
XD=switch,true,false,tag = 顶部-心动, desc = false为隐藏, true为显示
YY=switch,false,true,tag = 顶部-音乐, desc = false为隐藏, true为显示
BK=switch,false,true,tag = 顶部-播客, desc = false为隐藏, true为显示
TS=switch,false,true,tag = 顶部-听书, desc = false为隐藏, true为显示
HDTAB=switch,false,true,tag = 顶部-活动Tab, desc = false为隐藏, true为显示
PRGG=switch,false,true,tag = 首页-问候语, desc = false为隐藏, true为显示
PRDRD=switch,true,false,tag = 首页-每日推荐, desc = false为隐藏, true为显示
PRSCVPT=switch,true,false,tag = 首页-推荐歌单, desc = false为隐藏, true为显示
PRST=switch,false,true,tag = 首页-最近常听, desc = false为隐藏, true为显示
HMPR=switch,false,true,tag = 首页-音乐合伙人, desc = false为隐藏, true为显示
PRRR=switch,true,false,tag = 首页-雷达歌单, desc = false为隐藏, true为显示
PRRK=switch,true,false,tag = 首页-排行榜, desc = false为隐藏, true为显示
PRMST=switch,true,false,tag = 首页-推荐专属歌单, desc = false为隐藏, true为显示
PRCN=switch,true,false,tag = 首页-你的专属歌单, desc = false为隐藏, true为显示
PRPRS=switch,false,true,tag = 首页-私房推荐歌曲, desc = false为隐藏, true为显示
PRRSS=switch,false,true,tag = 首页-红心相似歌曲, desc = false为隐藏, true为显示
Music163_VIP_Shared=switch,false,true,tag = 启用[共享会员], desc = 是否启用网易云音乐共享会员
Cookie=input,"",tag = Cookie, desc = 请填写Cookie值
MConfigInfo=input,"",tag = MConfigInfo, desc = 请填写MConfigInfo值
UserAgent=input,"",tag = UserAgent, desc = 请填写UserAgent值

[Rule]
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmatapk.nosdn.127.net,REJECT
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmatvideo.music.126.net,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163.com\/x?e?api\/ad/i then response.body.mock("text", "{}", 200)
request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163.com\/x?e?api\/ad/I then reject_dict(200)
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/[wx]?e?api\/(?:side-bar\/mini-program\/music-service\/account|delivery\/(batch-deliver|deliver)|moment\/tab\/info\/get|yunbei\/account\/entrance\/get)/I then reject_dict(200)
request if ${url} ~= /^https?:\/\/music\.163\.com\/x?eapi\/delivery\/(batch-deliver|deliver)/I then reject_dict(200)
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/x?eapi\/(?:resource\/comments?\/musiciansaid|community\/friends\/fans-group\/artist\/group\/get|user\/sub\/artist|music\/songshare\/text\/recommend\/get|mine\/applet\/redpoint|resniche\/position\/play\/new\/get)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163.com\/[wx]?e?api\/search\/default/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163.com\/[wx]?e?api\/(?:search\/(chart|rcmd\/keyword|specialkeyword)|resource-exposure\/|activity\/bonus\/playpage\/time\/query)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163.com\/x?eapi\/(?:mlivestream\/entrance\/playpage|link\/(position\/show\/strategy|scene\/show)|ios\/version|v\d\/content\/exposure\/comment\/banner)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/store\/x?e?api\/(webconfig|entryconfig)/i then reject_dict(200)

[Script]
request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/(?:v1\/artist\/top\/song|v3\/discovery\/recommend\/songs)/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/loon_CloudMusic.vip.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]播放会员歌曲"

request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/v3\/song\/detail/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/loon_CloudMusic.vip.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]播放会员歌曲"

request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/song\/(?:chorus|enhance\/|play\/|type\/detail\/get)/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/loon_CloudMusic.vip.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]播放会员歌曲"

request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/playermode\//i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/loon_CloudMusic.vip.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]播放器会员皮肤"

request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/search\/(?:complex\/page|complex\/rec\/song\/get|song\/list\/page)/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/loon_CloudMusic.vip.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]搜索结果会员歌曲"

request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/vipnewcenter\/app\/resource\/newaccountpage/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/loon_CloudMusic.vip.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]侧边栏会员等级"

request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/w?e?api\/(?:homepage\/|v6\/)?playlist\/(?!(?:delete|subscribe|unsubscribe))/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/loon_CloudMusic.vip.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]歌单列表会员认证"

request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/vipauth\/app\/auth\/(soundquality\/)?query/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/loon_CloudMusic.vip.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]会员认证"

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/(batch|v\d\/resource\/comment\/floor\/get|v1\/user\/info|resource\/comments\/reply\/preload|comment\/feed\/inserted\/resources\/combined)/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/Yu9191_wyyad.js") with tag="[网易云音乐]通用广告", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/sp\/flow\/popup\/query/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/Yu9191_wyyad.js") with tag="[网易云音乐]免流推广弹窗", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/home\/framework\/tab/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/Yu9191_wyyad.js", {${FX}, ${MY}, ${DT}, ${GZ}, ${SOU}, ${SY_NAME}, ${WD_NAME}, ${MY_NAME}, ${DT_NAME}, ${FX_NAME}}) with tag="[网易云音乐]底部Tab", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/home\/framework\/top\/tab/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/Yu9191_wyyad.js", {${XD}, ${YY}, ${BK}, ${TS}, ${HDTAB}}) with tag="[网易云音乐]顶部Tab", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/((ipv4|interface\d?)\.)?music\.163\.com\/x?e?api\/vipactivity\/app\/cashier\/setting\/get/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/Yu9191_wyyad.js") with tag="[网易云音乐]收银台广告", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/(homepage\/block\/page|link\/page\/rcmd\/(resource\/show|block\/resource\/multi\/refresh))/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/Yu9191_wyyad.js", {${PRGG}, ${PRDRD}, ${PRSCVPT}, ${PRST}, ${HMPR}, ${PRRR}, ${PRRK}, ${PRMST}, ${PRCN}, ${PRPRS}, ${PRRSS}}) with tag="[网易云音乐]首页卡片", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/page\/discovery\/resource\/show/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/Yu9191_wyyad.js") with tag="[网易云音乐]发现", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/position\/show\/resource/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/Yu9191_wyyad.js") with tag="[网易云音乐]我的", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/user\/follow\/users\/mixed\/get/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/Yu9191_wyyad.js") with tag="[网易云音乐]关注", timeout=20, requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/music\.163\.com\/wyy-settings/i then script("https://github.com/ifflagged/Miami/raw/main/Modules/JavaScript/sooyaaabo/NeteaseMusic/Yu9191_wyyad.js") with tag="[网易云音乐]去广告设置页", timeout=20

[MITM]
hostname = music.163.com, interface.music.163.com, interface3.music.163.com, interface9.music.163.com, httpdns.n.netease.com, ipv4.music.163.com

